{
  "productName": "Radiumical",
  "version": "0.1.0",
  "identifier": "dev.radiumical.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Radiumical",
      "width": 1100,
      "height": 750
    }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}
